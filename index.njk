---
layout: base.njk
permalink: "index.html"
themeColor: "#161b18"
ogTitle: "Vajragarbha - Buddhist & Dzogchen Teachings"
ogDescription: "Wise and compassionate Buddhist & Dzogchen teachings with Lama Michael Gregory."
eleventyComputed:
  title: "{{ home.title | safe }}"
  description: "{{ home.description | safe }}"
---
<main id="main">
<section class="hero" aria-labelledby="hero-title"><div class="wrap hero-content">
 <span class="hero-mark" aria-hidden="true">✧</span>
 <div class="hero-mobile-kicker">{{ home.hero.eyebrow }}</div>
 <div class="eyebrow"><span class="hero-eyebrow-desktop">{{ home.hero.eyebrow }}</span><span class="hero-eyebrow-mobile">{{ home.hero.heading | safe }}</span></div>
 <h1 id="hero-title">{{ home.hero.heading | safe }}</h1>
 <p class="hero-lead-desktop">{{ home.hero.text }}</p>
 <div class="actions"><a class="btn gold" href="#free">Begin the Free Course <span aria-hidden="true">→</span></a><a class="btn outline" href="#teacher">Meet Lama Michael</a></div>
</div></section>
<div class="hero-copy-mobile">
 <p>{{ home.hero.text }}</p>
</div>

<section class="trust-strip" aria-label="Teaching highlights"><div class="wrap">
 <div class="hero-meta">{% for item in home.trustStrip %}<span><strong>{{ item.stat }}</strong>{{ item.label }}</span>{% endfor %}</div>
</div></section>

<section class="free" id="free"><div class="wrap split">
 <div class="free-copy"><div class="eyebrow">{{ home.free.eyebrow }}</div><h2>{{ home.free.heading }}</h2><div class="rule"></div>
  <p class="lead">{{ home.free.lead }}</p>
  <ul class="bullets">{% for b in home.free.bullets | splitLines %}<li>{{ b }}</li>{% endfor %}</ul>
  <form class="course-signup" action="#" method="post">
   <div class="course-field"><label for="course-first-name">First name</label><input id="course-first-name" name="first_name" type="text" autocomplete="given-name" placeholder="Your first name" required></div>
   <div class="course-field"><label for="course-email">Email address</label><input id="course-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required></div>
   <button class="btn gold" type="submit">Start the Free Course <span aria-hidden="true">→</span></button>
  </form>
  <p class="note">{{ home.free.note }}</p>
 </div>
 <div class="photo-card" aria-label="Free mindfulness course"><div class="photo" role="img" aria-label="Preview image from the free mindfulness course"></div></div>
</div></section>

<section class="teacher" id="teacher"><div class="wrap">
 <div class="split">
  <div class="photo-card"><div class="photo" role="img" aria-label="Portrait of Lama Michael Gregory"></div></div>
  <div><div class="eyebrow">{{ home.teacher.eyebrow }}</div><h2>{{ home.teacher.heading }}</h2><div class="rule"></div>
   <p class="lead">{{ home.teacher.bio1 }}</p>
   <p class="lead">{{ home.teacher.bio2 }}</p>
   <div class="compact-lineage" aria-label="Lama Michael's teachers and lineage"><div class="compact-lineage-head"><h3>{{ home.teacher.lineageHeading }}</h3><span>{{ home.teacher.lineageSub }}</span></div><div class="compact-masters"><div><span class="compact-master-image dalai" role="img" aria-label="H.H. The Dalai Lama"></span><p><strong>H.H. The Dalai Lama</strong><small>Indo-Tibetan tradition</small></p></div><div><span class="compact-master-image penor" role="img" aria-label="H.H. Penor Rinpoche"></span><p><strong>H.H. Penor Rinpoche</strong><small>Root teacher</small></p></div><div><span class="compact-master-image elder" role="img" aria-label="Receiving direct transmission"></span><p><strong>Direct Transmission</strong><small>Decades of personal study</small></p></div></div></div>
  </div>
 </div>
</div></section>

<section class="our-teachers"><div class="wrap"><div class="our-teachers-inner"><div class="eyebrow">{{ home.ourTeachers.eyebrow }}</div><h2>{{ home.ourTeachers.heading }}</h2><div class="rule"></div><p class="lead">{{ home.ourTeachers.lead1 }}</p><p class="lead">{{ home.ourTeachers.lead2 }}</p></div>
 <div class="teacher-grid">
  <div><span class="teacher-avatar" style="background-image:url('images/Portrait-Michael.jpg')" role="img" aria-label="{{ home.ourTeachers.list[0].name }}"></span><p><strong>{{ home.ourTeachers.list[0].name }}</strong><small>{{ home.ourTeachers.list[0].bio }}</small></p></div>
  <div><span class="teacher-avatar teacher-avatar-initials" aria-hidden="true">LP</span><p><strong>{{ home.ourTeachers.list[1].name }}</strong><small>{{ home.ourTeachers.list[1].bio }}</small></p></div>
  <div><span class="teacher-avatar teacher-avatar-initials" aria-hidden="true">LK</span><p><strong>{{ home.ourTeachers.list[2].name }}</strong><small>{{ home.ourTeachers.list[2].bio }}</small></p></div>
  <div><span class="teacher-avatar" style="background-image:url('https://img1.wsimg.com/isteam/ip/20890e6f-b39c-48ec-9eac-84cb7d053e57/4F3F37C1-8395-4AF0-85A7-5E2B38258FF0.jpeg/:/rs=w:200,h:200,cg:true')" role="img" aria-label="{{ home.ourTeachers.list[3].name }}"></span><p><strong>{{ home.ourTeachers.list[3].name }}</strong><small>{{ home.ourTeachers.list[3].bio }}</small></p></div>
 </div>
</div></section>

<section class="path" id="path"><div class="wrap"><div class="path-intro"><div class="eyebrow">{{ home.path.eyebrow }}</div><h2>{{ home.path.heading }}</h2><div class="rule"></div><p class="lead">{{ home.path.lead }}</p></div>
 <div class="path-visual">
 <div class="steps" aria-label="The progressive stages of the Dzogchen teaching path">
  <article class="step step-start"><div class="step-image"><img src="images/path-mindfulness.webp" alt="Meditation cushion beside a still bowl of water" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">01</div><h3>{{ home.path.steps[0].title }}</h3></div><span class="step-hours">{{ home.path.steps[0].hours }}</span><p>{{ home.path.steps[0].text }}</p><a class="link step-cta" href="#free"><span>{{ home.path.steps[0].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-mahayana.webp" alt="Luminous lotus reflected on calm water" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">02</div><h3>{{ home.path.steps[1].title }}</h3></div><span class="step-hours">{{ home.path.steps[1].hours }}</span><p>{{ home.path.steps[1].text }}</p><a class="link step-cta" href="mahayana.html"><span>{{ home.path.steps[1].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-tantra.webp" alt="Ritual bell and vajra in warm candlelight" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">03</div><h3>{{ home.path.steps[2].title }}</h3></div><span class="step-hours">{{ home.path.steps[2].hours }}</span><p>{{ home.path.steps[2].text }}</p><a class="link step-cta" href="tantra.html"><span>{{ home.path.steps[2].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-dzogchen.webp" alt="Clear open sky above a spacious mountain horizon" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">04</div><h3>{{ home.path.steps[3].title }}</h3></div><span class="step-hours">{{ home.path.steps[3].hours }}</span><p>{{ home.path.steps[3].text }}</p><a class="link step-cta" href="dzogchen-transmissions.html"><span>{{ home.path.steps[3].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
 </div>
 <article class="step membership-step"><div class="step-image"><img src="images/path-complete.jpg" alt="Streams of light converging into one mountain path" width="600" height="450" loading="lazy" decoding="async"><span class="membership-badge">The path continues here</span></div><div class="membership-promo"><div class="step-heading"><h3>The Complete Teachings</h3></div><span class="step-hours step-hours-included">Included in the Membership</span><p>Follow the complete path - from Buddhist foundations and Mahayana to Vajrayana, Mahamudra, and Dzogchen - within one guided membership. Learn live, return to the recordings anytime, and deepen your practice alongside experienced teachers and a committed Sangha.</p><ul class="membership-benefits" aria-label="Membership highlights"><li>Complete staged curriculum</li><li>Live teachings and Q&amp;A</li><li>Full on-demand library</li><li>Practice community and support</li></ul><div class="membership-promo-action"><span class="membership-price">Membership from <strong>$149</strong><small>/month</small></span><a class="btn gold" href="membership.html">Discover the Complete Path <span aria-hidden="true">→</span></a></div></div></article>
 </div>
 <p class="path-note">{{ home.path.note }}</p>
</div></section>

<section id="live"><div class="wrap"><div class="schedule-head"><div><div class="eyebrow">{{ home.live.eyebrow }}</div><h2>{{ home.live.heading }}</h2></div><p class="lead">{{ home.live.lead }}</p></div>
 <div class="live-access"><div><span class="access-label">Membership Access</span><strong>{{ home.live.accessNote }}</strong></div><a class="btn gold live-access-cta" href="#membership">View Membership Benefits <span aria-hidden="true">↓</span></a></div>
 <div class="events">
  {% for e in home.live.events %}<div class="event"><div class="event-day">{{ e.day }}</div><div><h3>{{ e.title }}</h3><p>{{ e.text }}</p></div><div class="time">{{ e.time }}<br>LIVE ONLINE</div></div>
  {% endfor %}
 </div>
</div></section>

<section class="sangha" id="membership"><div class="wrap membership">
 <div class="membership-content"><div class="eyebrow dark-eyebrow">{{ home.membership.eyebrow }}</div><h2>{{ home.membership.heading }}</h2><p class="lead">{{ home.membership.lead }}</p>
  <div class="checks">{% for c in home.membership.checks | splitLines %}<div class="check"><span>✦</span>{{ c }}</div>{% endfor %}</div>
 </div>
 <aside class="membership-side"><div class="membership-image"><img src="https://img1.wsimg.com/isteam/ip/20890e6f-b39c-48ec-9eac-84cb7d053e57/DEECAA97-8D54-4238-A307-8BE352B5EC71.jpeg/:/rs=w:900" alt="Vajragarbha Dzogchen Sangha gathering" loading="lazy" decoding="async"></div><div class="membership-cta-card"><div class="eyebrow dark-eyebrow">{{ home.membership.sideEyebrow }}</div><h3>{{ home.membership.sideHeading }}</h3><p>{{ home.membership.sideText }}</p><a class="btn gold" href="membership.html">Become a Member <span aria-hidden="true">→</span></a></div></aside>
</div></section>

<section class="quote" aria-label="Longchenpa quotation"><div class="wrap"><div class="quote-mark" aria-hidden="true">✦</div><blockquote>&ldquo;{{ home.quote.text }}&rdquo;</blockquote><cite>{{ home.quote.cite }}</cite></div></section>

<section class="retreat-center" id="retreat-center"><div class="wrap">
 <div class="split">
  <div class="photo-card"><div class="photo" role="img" aria-label="Quiet Mind Buddhist Retreat Center grounds in the hills outside San Diego"></div></div>
  <div><div class="eyebrow">{{ home.retreatCenter.eyebrow }}</div><h2>{{ home.retreatCenter.heading }}</h2><div class="rule"></div>
   <p class="lead">{{ home.retreatCenter.lead1 }}</p>
   <p class="lead">{{ home.retreatCenter.lead2 }}</p>
   <a class="btn ghost" href="https://quietmindretreat.com/" target="_blank" rel="noopener">Learn More <span aria-hidden="true">→</span></a>
  </div>
 </div>
</div></section>


<section class="news" aria-labelledby="newsletter-title"><div class="wrap news-grid"><div><div class="eyebrow">{{ home.newsletter.eyebrow }}</div><h2 id="newsletter-title">{{ home.newsletter.heading }}</h2><p>{{ home.newsletter.text }}</p></div>
 <form class="newsletter" action="#" method="post"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="Your email address" required><button type="submit">Sign Up</button></form>
</div></section>
</main>
