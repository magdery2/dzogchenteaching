---
layout: base.njk
permalink: "index.html"
title: "Vajragarbha - Buddhist & Dzogchen Teachings with Lama Michael Gregory"
description: "Wise and compassionate Buddhist & Dzogchen teachings with Lama Michael Gregory. Begin with a free six-week mindfulness course, then continue through live teachings and guided practice."
themeColor: "#161b18"
ogTitle: "Vajragarbha - Buddhist & Dzogchen Teachings"
ogDescription: "Wise and compassionate Buddhist & Dzogchen teachings with Lama Michael Gregory."

hero:
  eyebrow: "Interactive, Online & On-Demand Buddhist Courses"
  heading: "Wise and Compassionate <em>Buddhist &amp; Dzogchen Teachings</em>"
  text: "A comprehensive, interactive course system on the complete Buddhist path to liberation - following the traditional stages of Lam Rim, from Theravāda and Mahayana through Tantra, Mahamudra, and Dzogchen, taught live with Lama Michael Gregory."

trustStrip:
  - { stat: "30+ years", label: "of Buddhist training" }
  - { stat: "Live weekly", label: "guided teachings" }
  - { stat: "Free to begin", label: "six-week foundation" }

free:
  eyebrow: "Free to Begin"
  heading: "A Serious Introduction to Mindfulness"
  lead: "A six-week video course led personally by Lama Michael. This is the door into everything else we teach: the classical foundations of Buddhist mindfulness, made clear and practical."
  bullets:
    - "Six guided video classes, at your own pace"
    - "Watch how your mental and emotional world unfolds, non-reactively"
    - "Learn to respond with heart and wisdom"
    - "No prior experience or membership required"
  note: "Completing this course is how Lama Michael gets to know you, and where to guide you next on the path."

teacher:
  eyebrow: "Your Teacher"
  heading: "About Lama Michael Gregory"
  bio1: "Lama Michael Gregory is a Buddhist teacher whose training spans more than three decades across the Indo-Tibetan and Theravāda traditions. Beginning his studies in the early 1990s, he apprenticed under many of the greatest meditation masters of Tibet, including HH The Dalai Lama, and his root teacher from his teenage years, HH Penor Rinpoche."
  bio2: "He teaches the complete Buddhist path to liberation, following the traditional stages of Lam Rim, and personally guides students from their first class toward the practices suited to them."
  lineageHeading: "Trained Personally Under Living Masters"
  lineageSub: "An Unbroken Lineage"

ourTeachers:
  eyebrow: "Our Teachers"
  heading: "Guidance From Every Background"
  lead1: "Lama Michael and Lama Philip, together with many other teachers from diverse backgrounds and genders, bring years of experience in teaching and long-term retreat practice."
  lead2: "Whether you are a beginner or an advanced student, our courses cater to all levels of understanding and help you progress on your spiritual journey toward enlightenment."
  list:
    - name: "Lama Michael Gregory"
      bio: "30+ years in the Indo-Tibetan & Theravāda traditions"
    - name: "Lama Philip"
      bio: "Mahayana, Buddha Nature & Tantra teachings"
    - name: "Lama Kinley"
      bio: "Bodhisattva's Way of Life, Three Vows & Phowa"
    - name: "Lama Chris Wilkinson"
      bio: "Translator & teacher of the Great Perfection Tantras"

path:
  eyebrow: "The Dzogchen Path"
  heading: "One Path, Taught in Order"
  lead: "Most students move through these five stages in sequence, live and in community, with Lama Michael guiding each person toward the right next step."
  note: "Not sure where you'd start? Begin with the free Mindfulness course above. Lama Michael personally points every student toward their next step from there."
  steps:
    - title: "Mindfulness"
      hours: "12h of teaching"
      text: "The six-week foundation. Learn to watch the mind clearly before anything else."
      ctaLabel: "Begin Free"
    - title: "Mahayana Teachings"
      hours: "52h of teaching"
      text: "The path of compassion and bodhicitta, turning practice toward all beings."
      ctaLabel: "Explore Mahayana"
    - title: "Tantra Teachings"
      hours: "48h of teaching"
      text: "Skillful means. Live weekly with Lama Philip, for students who've taken empowerment."
      ctaLabel: "Explore Tantra"
    - title: "Dzogchen Transmissions"
      hours: "62h of teaching"
      text: "The Lion Stops Hunting. Live Saturdays with Lama Chris Wilkinson: complete transmission of the Great Perfection Tantras."
      ctaLabel: "Discover Dzogchen"

live:
  eyebrow: "Weekly Teaching Schedule"
  heading: "Live Teachings for Sangha Members"
  lead: "Our interactive courses encourage collaboration and engagement with both peers and teachers - practice in real time, ask questions, and stay connected to the rhythm of the teachings."
  accessNote: "Every live class and its recording is included with Sangha membership."
  events:
    - day: "Sunday"
      title: "Sacred Sundays"
      text: "Mindfulness Meditation and Q&A - Dharma teachings, guided meditation and Q&A on bringing practice into everyday life."
      time: "8–10am PST"
    - day: "Tuesday"
      title: "Maha, Anu & Ati"
      text: "Live and recorded with Lama Michael: the core weekly Dzogchen class, direct introduction to the nature of mind."
      time: "4–6pm PST"
    - day: "Thursday"
      title: "Tantra Teachings"
      text: "Teachings with Lama Philip - Buddhist Tantra teachings and Q&A. Suitable for practitioners with empowerment."
      time: "5–7pm PST"
    - day: "Monday"
      title: "Dzogchen & Mahayana"
      text: "Teachings with Lama Kinley - weekly Dzogchen and Mahayana teachings."
      time: "4–6pm PST"
    - day: "Every Day"
      title: "Daily Guided Meditations with Lama Roseanne"
      text: "A short guided sit to open the day, every morning."
      time: "5–6am PST"

membership:
  eyebrow: "Support Our Dzogchen Sangha"
  heading: "Vajragarbha: Dzogchen Sangha Membership"
  lead: "Once you've found your footing on the path, membership is the home for ongoing practice: full access to every live class, the recorded library, and direct connection to the community."
  checks:
    - "Live Dzogchen, Tantra & Mahayana Classes: full access to current live course offerings, plus recordings and materials on Teachable."
    - "Live Classes Every Day: Theravāda, Mahayana, Vajrayana and Tantra teachings with experienced teachers."
    - "Special Live Sunday Q&A: guided meditation and stories on bringing the teachings into daily life and relationships."
    - "Private Sangha Group: daily teachings from Lama Michael, exclusively for members."
    - "Weekly Dharma Mailer: one clear note a week, not a flood of updates."
  sideEyebrow: "Your Practice Community"
  sideHeading: "Join the Sangha"
  sideText: "Become a member for live teachings, the complete recording library, practice resources, and ongoing community support."

quote:
  text: "Naturally occurring timeless awareness, utterly lucid awakened mind, is something marvelous and superb, primordially and spontaneously present."
  cite: "Longchenpa"

retreatCenter:
  eyebrow: "Solo & Group Retreat"
  heading: "The Quiet Mind Buddhist Retreat Center in San Diego, CA"
  lead1: "Quiet Mind Retreat Center was created to assist contemplatives and meditators as a place to practice with ongoing instruction from among the very best of living yogis and scholars, in forested hills just outside San Diego."
  lead2: "We focus on providing the most supportive solo retreat and group retreat experience with crystal clear teaching and meditation, directed by Lama Michael Gregory."

newsletter:
  eyebrow: "Stay Connected"
  heading: "Dharma Teachings, Straight to Your Inbox"
  text: "One list, one weekly note: updates on live classes, courses and retreats. No spam, unsubscribe anytime."
---
<main id="main">
<section class="hero" aria-labelledby="hero-title"><div class="wrap hero-content">
 <div class="eyebrow">{{ hero.eyebrow }}</div>
 <h1 id="hero-title">{{ hero.heading | safe }}</h1>
 <p>{{ hero.text }}</p>
 <div class="actions"><a class="btn gold" href="#free">Begin the Free Course <span aria-hidden="true">→</span></a><a class="btn outline" href="#teacher">Meet Lama Michael</a></div>
</div></section>

<section class="trust-strip" aria-label="Teaching highlights"><div class="wrap">
 <div class="hero-meta">{% for item in trustStrip %}<span><strong>{{ item.stat }}</strong>{{ item.label }}</span>{% endfor %}</div>
</div></section>

<section class="free" id="free"><div class="wrap split">
 <div class="free-copy"><div class="eyebrow">{{ free.eyebrow }}</div><h2>{{ free.heading }}</h2><div class="rule"></div>
  <p class="lead">{{ free.lead }}</p>
  <ul class="bullets">{% for b in free.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  <form class="course-signup" action="#" method="post">
   <div class="course-field"><label for="course-first-name">First name</label><input id="course-first-name" name="first_name" type="text" autocomplete="given-name" placeholder="Your first name" required></div>
   <div class="course-field"><label for="course-email">Email address</label><input id="course-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required></div>
   <button class="btn gold" type="submit">Start the Free Course <span aria-hidden="true">→</span></button>
  </form>
  <p class="note">{{ free.note }}</p>
 </div>
 <div class="photo-card" aria-label="Free mindfulness course"><div class="photo" role="img" aria-label="Preview image from the free mindfulness course"></div></div>
</div></section>

<section class="teacher" id="teacher"><div class="wrap">
 <div class="split">
  <div class="photo-card"><div class="photo" role="img" aria-label="Portrait of Lama Michael Gregory"></div></div>
  <div><div class="eyebrow">{{ teacher.eyebrow }}</div><h2>{{ teacher.heading }}</h2><div class="rule"></div>
   <p class="lead">{{ teacher.bio1 }}</p>
   <p class="lead">{{ teacher.bio2 }}</p>
   <div class="compact-lineage" aria-label="Lama Michael's teachers and lineage"><div class="compact-lineage-head"><h3>{{ teacher.lineageHeading }}</h3><span>{{ teacher.lineageSub }}</span></div><div class="compact-masters"><div><span class="compact-master-image dalai" role="img" aria-label="H.H. The Dalai Lama"></span><p><strong>H.H. The Dalai Lama</strong><small>Indo-Tibetan tradition</small></p></div><div><span class="compact-master-image penor" role="img" aria-label="H.H. Penor Rinpoche"></span><p><strong>H.H. Penor Rinpoche</strong><small>Root teacher</small></p></div><div><span class="compact-master-image elder" role="img" aria-label="Receiving direct transmission"></span><p><strong>Direct Transmission</strong><small>Decades of personal study</small></p></div></div></div>
  </div>
 </div>
</div></section>

<section class="our-teachers"><div class="wrap"><div class="our-teachers-inner"><div class="eyebrow">{{ ourTeachers.eyebrow }}</div><h2>{{ ourTeachers.heading }}</h2><div class="rule"></div><p class="lead">{{ ourTeachers.lead1 }}</p><p class="lead">{{ ourTeachers.lead2 }}</p></div>
 <div class="teacher-grid">
  <div><span class="teacher-avatar" style="background-image:url('images/Portrait-Michael.jpg')" role="img" aria-label="{{ ourTeachers.list[0].name }}"></span><p><strong>{{ ourTeachers.list[0].name }}</strong><small>{{ ourTeachers.list[0].bio }}</small></p></div>
  <div><span class="teacher-avatar teacher-avatar-initials" aria-hidden="true">LP</span><p><strong>{{ ourTeachers.list[1].name }}</strong><small>{{ ourTeachers.list[1].bio }}</small></p></div>
  <div><span class="teacher-avatar teacher-avatar-initials" aria-hidden="true">LK</span><p><strong>{{ ourTeachers.list[2].name }}</strong><small>{{ ourTeachers.list[2].bio }}</small></p></div>
  <div><span class="teacher-avatar" style="background-image:url('https://img1.wsimg.com/isteam/ip/20890e6f-b39c-48ec-9eac-84cb7d053e57/4F3F37C1-8395-4AF0-85A7-5E2B38258FF0.jpeg/:/rs=w:200,h:200,cg:true')" role="img" aria-label="{{ ourTeachers.list[3].name }}"></span><p><strong>{{ ourTeachers.list[3].name }}</strong><small>{{ ourTeachers.list[3].bio }}</small></p></div>
 </div>
</div></section>

<section class="path" id="path"><div class="wrap"><div class="path-intro"><div class="eyebrow">{{ path.eyebrow }}</div><h2>{{ path.heading }}</h2><div class="rule"></div><p class="lead">{{ path.lead }}</p></div>
 <div class="path-visual">
 <div class="steps" aria-label="The progressive stages of the Dzogchen teaching path">
  <article class="step step-start"><div class="step-image"><img src="images/path-mindfulness.webp" alt="Meditation cushion beside a still bowl of water" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">01</div><h3>{{ path.steps[0].title }}</h3></div><span class="step-hours">{{ path.steps[0].hours }}</span><p>{{ path.steps[0].text }}</p><a class="link step-cta" href="#free"><span>{{ path.steps[0].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-mahayana.webp" alt="Luminous lotus reflected on calm water" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">02</div><h3>{{ path.steps[1].title }}</h3></div><span class="step-hours">{{ path.steps[1].hours }}</span><p>{{ path.steps[1].text }}</p><a class="link step-cta" href="mahayana.html"><span>{{ path.steps[1].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-tantra.webp" alt="Ritual bell and vajra in warm candlelight" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">03</div><h3>{{ path.steps[2].title }}</h3></div><span class="step-hours">{{ path.steps[2].hours }}</span><p>{{ path.steps[2].text }}</p><a class="link step-cta" href="tantra.html"><span>{{ path.steps[2].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step"><div class="step-image"><img src="images/path-dzogchen.webp" alt="Clear open sky above a spacious mountain horizon" width="600" height="450" loading="lazy" decoding="async"></div><div class="step-heading"><div class="num">04</div><h3>{{ path.steps[3].title }}</h3></div><span class="step-hours">{{ path.steps[3].hours }}</span><p>{{ path.steps[3].text }}</p><a class="link step-cta" href="dzogchen-transmissions.html"><span>{{ path.steps[3].ctaLabel }}</span><span class="cta-arrow" aria-hidden="true">→</span></a></article>
  <article class="step membership-step"><div class="step-image"><img src="images/path-complete.webp" alt="Streams of light converging into one mountain path" width="600" height="450" loading="lazy" decoding="async"><span class="membership-badge">The path continues here</span></div><div class="membership-promo"><div class="step-heading"><h3>The Complete Teachings</h3></div><span class="step-hours step-hours-included">Included in the Membership</span><p>Follow the complete path - from Buddhist foundations and Mahayana to Vajrayana, Mahamudra, and Dzogchen - within one guided membership. Learn live, return to the recordings anytime, and deepen your practice alongside experienced teachers and a committed Sangha.</p><ul class="membership-benefits" aria-label="Membership highlights"><li>Complete staged curriculum</li><li>Live teachings and Q&amp;A</li><li>Full on-demand library</li><li>Practice community and support</li></ul><div class="membership-promo-action"><span class="membership-price">Membership from <strong>$149</strong><small>/month</small></span><a class="btn gold" href="membership.html">Discover the Complete Path <span aria-hidden="true">→</span></a></div></div></article>
 </div></div>
 <p class="path-note">{{ path.note }}</p>
</div></section>

<section id="live"><div class="wrap"><div class="schedule-head"><div><div class="eyebrow">{{ live.eyebrow }}</div><h2>{{ live.heading }}</h2></div><p class="lead">{{ live.lead }}</p></div>
 <div class="live-access"><div><span class="access-label">Membership Access</span><strong>{{ live.accessNote }}</strong></div><a class="btn gold live-access-cta" href="#membership">View Membership Benefits <span aria-hidden="true">↓</span></a></div>
 <div class="events">
  {% for e in live.events %}<div class="event"><div class="event-day">{{ e.day }}</div><div><h3>{{ e.title }}</h3><p>{{ e.text }}</p></div><div class="time">{{ e.time }}<br>LIVE ONLINE</div></div>
  {% endfor %}
 </div>
</div></section>

<section class="sangha" id="membership"><div class="wrap membership">
 <div class="membership-content"><div class="eyebrow dark-eyebrow">{{ membership.eyebrow }}</div><h2>{{ membership.heading }}</h2><p class="lead">{{ membership.lead }}</p>
  <div class="checks">{% for c in membership.checks %}<div class="check"><span>✦</span>{{ c }}</div>{% endfor %}</div>
 </div>
 <aside class="membership-side"><div class="membership-image"><img src="https://img1.wsimg.com/isteam/ip/20890e6f-b39c-48ec-9eac-84cb7d053e57/DEECAA97-8D54-4238-A307-8BE352B5EC71.jpeg/:/rs=w:900" alt="Vajragarbha Dzogchen Sangha gathering" loading="lazy" decoding="async"></div><div class="membership-cta-card"><div class="eyebrow dark-eyebrow">{{ membership.sideEyebrow }}</div><h3>{{ membership.sideHeading }}</h3><p>{{ membership.sideText }}</p><a class="btn gold" href="membership.html">Become a Member <span aria-hidden="true">→</span></a></div></aside>
</div></section>

<section class="quote" aria-label="Longchenpa quotation"><div class="wrap"><div class="quote-mark" aria-hidden="true">✦</div><blockquote>&ldquo;{{ quote.text }}&rdquo;</blockquote><cite>{{ quote.cite }}</cite></div></section>

<section class="retreat-center" id="retreat-center"><div class="wrap">
 <div class="split">
  <div class="photo-card"><div class="photo" role="img" aria-label="Quiet Mind Buddhist Retreat Center grounds in the hills outside San Diego"></div></div>
  <div><div class="eyebrow">{{ retreatCenter.eyebrow }}</div><h2>{{ retreatCenter.heading }}</h2><div class="rule"></div>
   <p class="lead">{{ retreatCenter.lead1 }}</p>
   <p class="lead">{{ retreatCenter.lead2 }}</p>
   <a class="btn ghost" href="https://quietmindretreat.com/" target="_blank" rel="noopener">Learn More <span aria-hidden="true">→</span></a>
  </div>
 </div>
</div></section>


<section class="news" aria-labelledby="newsletter-title"><div class="wrap news-grid"><div><div class="eyebrow">{{ newsletter.eyebrow }}</div><h2 id="newsletter-title">{{ newsletter.heading }}</h2><p>{{ newsletter.text }}</p></div>
 <form class="newsletter" action="#" method="post"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="Your email address" required><button type="submit">Sign Up</button></form>
</div></section>
</main>
